/* VinWeb - Oberflaeche.
   Farben bewusst wie in SiteSett, damit sich beide Werkzeuge gleich anfuehlen. */

:root{
  --paper:#FAF9F5; --panel:#FFFFFF; --ink:#17181B; --ink-soft:#5B5E66; --muted:#9A9C9F;
  --line:#EBEAE3; --line-strong:#D8D7CD;
  /* Markenakzent: Royal Violet aus der VinWeb-Palette */
  --accent:#7A28CB; --accent-ink:#5E1FA0; --accent-soft:#F1E8FB;
  /* Ablauf-Kategorien – jede Phase hat ihre Farbe:
     Violett = Material rein · Rose = Prüfen · Aqua = Bearbeiten ·
     Orange = Veröffentlichen · Taupe = Verlauf/Absicherung */
  --kat-material:#7A28CB; --kat-pruefen:#E75A7C; --kat-bearbeiten:#3FBDB6;
  --kat-veroeffentlichen:#FFAE03; --kat-sichern:#463F3A;
  --blue:#2C6BD4; --blue-soft:#E9F0FB;
  --ok:#1F7A5A; --ok-soft:#EAF4EF;
  --warn:#B07A12; --warn-soft:#FBF3E1;
  --err:#D23B2C;
  --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --sans:"Helvetica Neue",Helvetica,Arial,system-ui,-apple-system,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:var(--sans);color:var(--ink);background:var(--paper);font-size:14px;line-height:1.55;
  -webkit-font-smoothing:antialiased;display:flex;flex-direction:column}
button{font-family:inherit;cursor:pointer}
code{font-family:var(--mono);font-size:.87em;background:#F2F1EA;padding:1px 5px;border-radius:2px}
a{color:var(--blue)}

/* ---------- Kopfzeile ---------- */
.top{display:flex;align-items:center;gap:18px;padding:0 22px;height:60px;background:var(--panel);
  border-bottom:1px solid var(--line-strong);flex-shrink:0}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:17px;letter-spacing:-.01em}
.brand .dot{width:15px;height:15px;border-radius:50%;border:2px solid var(--accent);position:relative;flex-shrink:0}
.brand .dot::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--blue)}
.brand small{font-weight:500;color:var(--muted);font-size:10px;letter-spacing:.15em;text-transform:uppercase;
  padding-left:11px;margin-left:1px;border-left:1px solid var(--line-strong)}
.top .spacer{flex:1}
.status{color:var(--ink-soft);font-size:12.5px;max-width:46ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.status.err{color:var(--accent-ink);font-weight:600}
.status.ok{color:var(--ok)}

.btn{background:transparent;color:var(--ink);border:1px solid var(--line-strong);border-radius:2px;
  padding:8px 13px;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;
  transition:border-color .12s,background .12s,color .12s}
.btn:hover{border-color:var(--ink)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.primary:hover{background:var(--accent-ink);border-color:var(--accent-ink)}
.btn.klein{padding:5px 9px;font-size:9.5px}

select,input[type=text]{font-family:inherit;font-size:13px;color:var(--ink);background:var(--panel);
  border:1px solid var(--line-strong);border-radius:2px;padding:7px 9px}
select:focus,input:focus{outline:2px solid var(--blue-soft);border-color:var(--blue)}

/* ---------- Grundgeruest ---------- */
.haupt{flex:1;display:flex;min-height:0}
.seite{width:290px;flex-shrink:0;background:var(--panel);border-right:1px solid var(--line-strong);
  display:flex;flex-direction:column;min-height:0}
.inhalt{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}

.block{padding:16px 18px;border-bottom:1px solid var(--line)}
.block h3{margin:0 0 10px;font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}

/* ---------- Import ---------- */
.dropzone{border:1.5px dashed var(--line-strong);border-radius:3px;padding:20px 14px;text-align:center;
  color:var(--ink-soft);font-size:12.5px;transition:border-color .12s,background .12s;cursor:pointer}
.dropzone:hover,.dropzone.aktiv{border-color:var(--accent);background:var(--accent-soft);color:var(--accent-ink)}
.dropzone b{display:block;color:var(--ink);font-size:13px;margin-bottom:3px}
.pfadzeile{display:flex;gap:6px;margin-top:10px}
.pfadzeile input{flex:1;min-width:0;font-size:12px}

/* ---------- Listen ---------- */
.liste{flex:1;overflow:auto;min-height:0}
.eintrag{display:block;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line);
  padding:9px 18px;font-size:13px;color:var(--ink);line-height:1.4}
.eintrag:hover{background:var(--paper)}
.eintrag.gewaehlt{background:var(--accent-soft);box-shadow:inset 3px 0 0 var(--accent)}
.eintrag .meta{display:block;font-size:11px;color:var(--muted);margin-top:1px}
.eintrag .meta.warn{color:var(--warn)}

/* ---------- Reiter ---------- */
.reiter{display:flex;gap:0;background:var(--panel);border-bottom:1px solid var(--line-strong);padding:0 18px;flex-shrink:0}
.reiter button{background:none;border:0;border-bottom:2px solid transparent;padding:13px 15px;
  font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.reiter button:hover{color:var(--ink)}
.reiter button.aktiv{color:var(--ink);border-bottom-color:var(--accent)}
.reiter .zahl{display:inline-block;margin-left:6px;background:var(--line);color:var(--ink-soft);
  border-radius:9px;padding:1px 6px;font-size:10px}
.reiter button.aktiv .zahl{background:var(--accent);color:#fff}

.panel{flex:1;overflow:auto;min-height:0;display:none}
.panel.aktiv{display:flex;flex-direction:column}

/* ---------- Vorschau ---------- */
.vorschau-leiste{display:flex;align-items:center;gap:8px;padding:10px 18px;border-bottom:1px solid var(--line);
  background:var(--panel);flex-shrink:0}
.vorschau-leiste .titel{font-size:12.5px;color:var(--ink-soft);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.buehne{flex:1;overflow:auto;background:#EFEEE7;padding:24px;min-height:0}
.geraete{display:flex;gap:26px;align-items:flex-start;justify-content:center}
.geraet .rahmenbox{position:relative;overflow:hidden;background:#fff;border:1px solid var(--line-strong);
  box-shadow:0 4px 22px rgba(0,0,0,.09)}
.geraet .rahmen{position:absolute;top:0;left:0;transform-origin:top left;background:#fff}
.geraet iframe{width:100%;height:100%;border:0;display:block;background:#fff}
.geraet .label{margin-top:9px;font-size:10.5px;color:var(--muted);text-align:center;
  letter-spacing:.05em;text-transform:uppercase;font-weight:600}
.leer{padding:60px 30px;text-align:center;color:var(--muted);font-size:14px}

/* ---------- Befunde ---------- */
.befunde{padding:20px 24px;max-width:960px}
.befund{border:1px solid var(--line-strong);border-radius:3px;margin-bottom:12px;background:var(--panel);overflow:hidden}
.befund .kopf{display:flex;align-items:flex-start;gap:11px;padding:13px 15px;cursor:pointer}
.befund .kopf:hover{background:var(--paper)}
.marke{font-size:9.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:3px 8px;
  border-radius:2px;border:1px solid transparent;flex-shrink:0;margin-top:1px}
.m-fehler{background:var(--accent-soft);color:var(--accent-ink);border-color:#F3CFC3}
.m-warnung{background:var(--warn-soft);color:var(--warn);border-color:#EEDFB6}
.m-hinweis{background:var(--blue-soft);color:var(--blue);border-color:#CFE0F6}
.m-ok{background:var(--ok-soft);color:var(--ok);border-color:#CDE7DC}
.befund .t{flex:1;min-width:0}
.befund .t b{display:block;font-size:13.5px;font-weight:600}
.befund .t span{display:block;font-size:12.5px;color:var(--ink-soft);margin-top:3px}
.befund .details{display:none;border-top:1px solid var(--line);padding:11px 15px;background:var(--paper)}
.befund.offen .details{display:block}
.befund .details ul{margin:0;padding-left:18px}
.befund .details li{font-family:var(--mono);font-size:11.5px;color:var(--ink-soft);margin:2px 0;word-break:break-all}

/* ---------- Tabelle Struktur ---------- */
.tab{width:100%;border-collapse:collapse;font-size:13px}
.tab th{text-align:left;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
  font-weight:700;padding:8px 10px;border-bottom:1px solid var(--line-strong);white-space:nowrap}
.tab td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
.tab td.mitte,.tab th.mitte{text-align:center}
.tab tr:hover td{background:var(--panel)}
.tab .pfad{font-family:var(--mono);font-size:12px}
.tab .grund{color:var(--ink-soft);font-size:12px}
.tab .zahl{color:var(--muted);font-size:12px;white-space:nowrap;text-align:right}
input[type=checkbox]{width:15px;height:15px;accent-color:var(--accent);cursor:pointer}

.hinweiskasten{background:var(--blue-soft);border:1px solid #CFE0F6;border-radius:3px;padding:12px 14px;
  font-size:12.5px;color:var(--ink-soft);margin-bottom:16px;line-height:1.6}
.hinweiskasten b{color:var(--ink)}

/* ---------- Chat ---------- */
.chat{width:400px;flex-shrink:0;background:var(--panel);border-left:1px solid var(--line-strong);
  display:flex;flex-direction:column;min-height:0}
.chat-kopf{display:flex;gap:6px;align-items:center;padding:11px 14px;border-bottom:1px solid var(--line)}
.chat-kopf select{font-size:12px;padding:6px 7px}
.chat-kopf #anbieter{width:96px;flex-shrink:0}

.chat-kontext{border-bottom:1px solid var(--line);font-size:12px}
.chat-kontext summary{padding:8px 14px;cursor:pointer;color:var(--ink-soft);list-style:none;
  display:flex;align-items:center;gap:6px}
.chat-kontext summary::before{content:"▸";color:var(--muted);font-size:10px}
.chat-kontext[open] summary::before{content:"▾"}
.chat-kontext summary:hover{background:var(--paper)}
.kontext-liste{max-height:190px;overflow:auto;padding:4px 14px 10px;background:var(--paper)}
.kontext-liste label{display:flex;align-items:center;gap:7px;padding:3px 0;font-size:12px;
  font-family:var(--mono);cursor:pointer;color:var(--ink-soft)}
.kontext-liste label:hover{color:var(--ink)}

.chat-verlauf{flex:1;overflow:auto;min-height:0;padding:14px}
.chat-leer{color:var(--muted);font-size:12.5px;line-height:1.65;padding:10px 2px}
.chat-leer em{color:var(--ink-soft)}

.bl{margin-bottom:14px;font-size:13px;line-height:1.6}
.bl .wer{font-size:9.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);margin-bottom:4px}
.bl.ich .txt{background:var(--blue-soft);border:1px solid #CFE0F6;border-radius:3px;padding:9px 11px;
  white-space:pre-wrap;word-break:break-word}
.bl.ki .txt{white-space:pre-wrap;word-break:break-word;color:var(--ink)}
.bl.fehler .txt{background:var(--accent-soft);border:1px solid #F3CFC3;color:var(--accent-ink);
  border-radius:3px;padding:9px 11px}
.bl .anhang-liste{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
.bl .verbrauch{font-size:10.5px;color:var(--muted);margin-top:5px;font-family:var(--mono)}

/* Änderungsvorschlag */
.vorschlag{border:1px solid var(--line-strong);border-radius:3px;margin-top:10px;overflow:hidden}
.vorschlag .v-kopf{display:flex;align-items:center;gap:8px;padding:9px 11px;background:var(--paper)}
.vorschlag .v-pfad{font-family:var(--mono);font-size:12px;flex:1;min-width:0;overflow:hidden;
  text-overflow:ellipsis;white-space:nowrap}
.vorschlag .v-zahlen{font-family:var(--mono);font-size:11px;white-space:nowrap}
.vorschlag .v-zahlen .p{color:var(--ok)}
.vorschlag .v-zahlen .m{color:var(--err)}
.vorschlag .v-diff{display:none;max-height:320px;overflow:auto;border-top:1px solid var(--line);
  background:#FCFBF7;font-family:var(--mono);font-size:11px;line-height:1.5;padding:8px 0}
.vorschlag.offen .v-diff{display:block}
.v-diff div{padding:0 11px;white-space:pre-wrap;word-break:break-all}
.v-diff .zu{background:#EAF4EF;color:#12503B}
.v-diff .weg{background:#FBE9E2;color:#93301A}
.v-diff .kopfz{color:var(--blue);background:var(--blue-soft)}
.vorschlag .v-fuss{display:flex;gap:7px;padding:9px 11px;border-top:1px solid var(--line)}
.vorschlag.erledigt{opacity:.55}

.chat-anhaenge{display:flex;flex-wrap:wrap;gap:5px;padding:0 14px}
.chat-anhaenge:not(:empty){padding:9px 14px 4px;border-top:1px solid var(--line)}
.chip{display:inline-flex;align-items:center;gap:5px;background:var(--paper);border:1px solid var(--line-strong);
  border-radius:2px;padding:3px 6px;font-size:11px;font-family:var(--mono);color:var(--ink-soft);max-width:100%}
.chip img{width:18px;height:18px;object-fit:cover;border-radius:2px}
.chip b{font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:150px}
.chip button{background:none;border:0;color:var(--muted);font-size:14px;line-height:1;padding:0 1px}
.chip button:hover{color:var(--err)}

.chat-eingabe{display:flex;gap:7px;align-items:flex-end;padding:11px 14px;border-top:1px solid var(--line-strong)}
.chat-eingabe textarea{flex:1;min-width:0;font-family:inherit;font-size:13px;line-height:1.5;
  border:1px solid var(--line-strong);border-radius:2px;padding:8px 9px;resize:vertical;
  color:var(--ink);background:var(--panel)}
.chat-eingabe textarea:focus{outline:2px solid var(--blue-soft);border-color:var(--blue)}
.plus{width:32px;height:32px;flex-shrink:0;border:1px solid var(--line-strong);border-radius:2px;
  background:var(--panel);font-size:19px;line-height:1;color:var(--ink-soft)}
.plus:hover{border-color:var(--accent);color:var(--accent)}

.tippt::after{content:"▍";animation:blink 1s steps(2) infinite;color:var(--accent)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

/* ---------- Dialog ---------- */
dialog{border:1px solid var(--line-strong);border-radius:4px;padding:0;background:var(--panel);
  box-shadow:0 12px 48px rgba(0,0,0,.2);max-width:520px;width:92vw}
dialog::backdrop{background:rgba(23,24,27,.42)}
.dlg{padding:24px 26px}
.dlg h2{margin:0 0 4px;font-size:17px;font-weight:700;letter-spacing:-.01em}
.dlg label{display:block;margin:16px 0 6px;font-size:11px;font-weight:700;letter-spacing:.09em;
  text-transform:uppercase;color:var(--muted)}
.dlg label small{font-weight:500;letter-spacing:0;text-transform:none;color:var(--muted)}
.dlg-zeile{display:flex;gap:8px;align-items:center}
.dlg-zeile input{flex:1;min-width:0;font-family:var(--mono);font-size:12px;padding:8px 9px;
  border:1px solid var(--line-strong);border-radius:2px}
.dlg-status{font-size:11px;color:var(--muted);white-space:nowrap;font-family:var(--mono)}
.dlg-status.ok{color:var(--ok)}
.dlg-info{font-size:12px;color:var(--ink-soft);line-height:1.6;margin:10px 0 0}
.dlg-knopfe{display:flex;justify-content:flex-end;gap:8px;margin-top:22px}

/* Schmalere Bildschirme: Spalten enger, damit alles sichtbar bleibt. */
@media (max-width: 1450px){
  .seite{width:240px}
  .chat{width:340px}
  .buehne{padding:14px}
}
@media (max-width: 1150px){
  .seite{width:200px}
  .chat{width:300px}
  .chat-kopf #anbieter{width:78px}
}

/* ---------- Verlauf ---------- */
.verlauf-leiste{display:flex;align-items:center;gap:9px;padding:11px 22px;border-bottom:1px solid var(--line);
  background:var(--panel);flex-shrink:0}
.verlauf-leiste input[type=text]{font-size:12.5px}
.warnstreifen{display:flex;align-items:center;gap:12px;padding:9px 22px;background:var(--warn-soft);
  border-bottom:1px solid #EEDFB6;color:var(--warn);font-size:12.5px;flex-shrink:0}
.warnstreifen span{flex:1}

.verlauf-liste{flex:1;overflow:auto;min-height:0;padding:16px 22px 40px;max-width:1000px}
.tag{font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);
  margin:18px 0 8px;padding-bottom:5px;border-bottom:1px solid var(--line)}
.tag:first-child{margin-top:0}

.stand{border:1px solid var(--line-strong);border-radius:3px;margin-bottom:7px;background:var(--panel);overflow:hidden}
.stand.jetzt{border-color:var(--accent);box-shadow:inset 3px 0 0 var(--accent)}
.s-kopf{display:flex;align-items:center;gap:11px;padding:10px 13px}
.s-zeit{font-family:var(--mono);font-size:12px;color:var(--ink-soft);width:44px;flex-shrink:0}
.s-text{flex:1;min-width:0;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.s-zahl{font-size:11px;color:var(--muted);white-space:nowrap;font-family:var(--mono)}
.s-details{display:none;border-top:1px solid var(--line);background:var(--paper);padding:11px 13px}
.stand.offen .s-details{display:block}
.s-dateien{display:flex;flex-direction:column;gap:3px;margin-bottom:10px}
.s-datei{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-size:11.5px;color:var(--ink-soft)}
.s-datei span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.s-hinweis{font-size:12px;color:var(--ink-soft);margin-bottom:9px;line-height:1.55}
.verlauf-leer{color:var(--muted);font-size:13px;padding:40px 0;text-align:center}

/* Ohne diese Zeile schlägt display:flex das hidden-Attribut – ein Element mit
   hidden bliebe sichtbar. Klassischer Stolperstein. */
[hidden]{display:none !important}

/* ---------- Build ---------- */
.build-gruppe{border:1px solid var(--line-strong);border-radius:3px;margin-bottom:12px;background:var(--panel);overflow:hidden}
.build-gruppe > h4{margin:0;padding:11px 15px;font-size:12px;font-weight:700;letter-spacing:.04em;
  background:var(--paper);border-bottom:1px solid var(--line);display:flex;justify-content:space-between}
.build-gruppe > h4 .z{color:var(--muted);font-weight:500}
.build-liste{max-height:280px;overflow:auto}
.build-zeile{display:flex;gap:11px;padding:6px 15px;font-size:12px;border-bottom:1px solid var(--line);align-items:baseline}
.build-zeile:last-child{border-bottom:0}
.build-zeile .pf{font-family:var(--mono);font-size:11.5px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.build-zeile .von{color:var(--err);font-family:var(--mono);font-size:11px}
.build-zeile .nach{color:var(--ok);font-family:var(--mono);font-size:11px}
.build-zeile .pfeil{color:var(--muted)}
.kachel-reihe{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.kachel{flex:1;min-width:120px;border:1px solid var(--line-strong);border-radius:3px;padding:13px 15px;background:var(--panel)}
.kachel .gross{font-size:24px;font-weight:800;letter-spacing:-.02em;line-height:1}
.kachel .klein{font-size:11px;color:var(--muted);margin-top:5px;text-transform:uppercase;letter-spacing:.06em}
.kachel.gut .gross{color:var(--ok)}
.kachel.warn .gross{color:var(--warn)}

/* ---------- SEO ---------- */
.seo-profil{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px 14px;padding:13px 15px}
.seo-profil label{display:block;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--muted);margin-bottom:4px}
.seo-profil input{width:100%;font-size:12.5px}
.seo-seite{border-bottom:1px solid var(--line);padding:11px 15px}
.seo-seite:last-child{border-bottom:0}
.seo-seite .kopf{display:flex;align-items:center;gap:10px;margin-bottom:7px}
.seo-seite .datei{font-family:var(--mono);font-size:12px;font-weight:600;flex:1}
.seo-seite .kopf label{font-size:11px;color:var(--ink-soft);display:flex;align-items:center;gap:5px;cursor:pointer}
.seo-seite input[type=text]{width:100%;font-size:12.5px;margin-bottom:6px}
.seo-seite .zeichen{font-size:10px;font-family:var(--mono);color:var(--muted);margin-left:6px}
.seo-seite .zeichen.gut{color:var(--ok)}
.seo-seite .zeichen.schlecht{color:var(--warn)}

/* ---------- Ablauf-Farben ---------- */
.reiter button{--kat:transparent}
.reiter button[data-kat=pruefen]{--kat:var(--kat-pruefen)}
.reiter button[data-kat=bearbeiten]{--kat:var(--kat-bearbeiten)}
.reiter button[data-kat=veroeffentlichen]{--kat:var(--kat-veroeffentlichen)}
.reiter button[data-kat=sichern]{--kat:var(--kat-sichern)}
.reiter button::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;
  background:var(--kat);margin-right:7px;vertical-align:1px}
.reiter button.aktiv{border-bottom-color:var(--kat,var(--accent));color:var(--ink)}
.reiter button.aktiv .zahl{background:var(--kat,var(--accent));color:#fff}
.reiter button.neu-gruppe{margin-left:12px;border-left:1px solid var(--line);padding-left:16px}

.ablauf-legende{margin-left:auto;display:flex;gap:13px;align-items:center;
  font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.ablauf-legende i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:4px;font-style:normal}

/* Seitenleiste: Blöcke nach Kategorie eingefärbt */
.block.kat-material{box-shadow:inset 3px 0 0 var(--kat-material)}
.block.kat-material h3::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;
  background:var(--kat-material);margin-right:6px}
.block.kat-seiten h3::before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;
  background:var(--kat-bearbeiten);margin-right:6px}

/* Chat-Spalte gehört zur Phase "Bearbeiten" */
.chat{border-top:3px solid var(--kat-bearbeiten)}
.chat-kat{font-size:9.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);padding:8px 14px 0}
.chat-kat i{display:inline-block;width:7px;height:7px;border-radius:50%;
  background:var(--kat-bearbeiten);margin-right:5px;font-style:normal}

/* Build = Veröffentlichen: der Hauptknopf trägt Orange */
.panel[data-panel=build] .btn.primary{background:var(--kat-veroeffentlichen);
  border-color:var(--kat-veroeffentlichen);color:#1a1a1a}
.panel[data-panel=build] .btn.primary:hover{background:#E69D00;border-color:#E69D00}

/* Seiten löschen: dezentes × erscheint beim Überfahren */
.eintrag{position:relative;padding-right:30px}
.seite-weg{position:absolute;right:8px;top:50%;transform:translateY(-50%);
  border:0;background:none;font-size:15px;line-height:1;color:var(--muted);
  opacity:0;cursor:pointer;padding:4px}
.eintrag:hover .seite-weg{opacity:.55}
.seite-weg:hover{opacity:1 !important;color:var(--err)}

/* Bei schmalem Fenster: Legende ausblenden, Reiter scrollbar halten */
.reiter{overflow-x:auto;scrollbar-width:none}
@media (max-width: 1500px){ .ablauf-legende{display:none} }

/* Kurze Erklärzeile am Kopf eines Reiters */
.tab-info{padding:9px 18px;font-size:12px;color:var(--ink-soft);background:var(--panel);
  border-bottom:1px solid var(--line);flex-shrink:0;line-height:1.5}
.tab-info b{color:var(--ink)}
